# DailyDialz website — public payment config (safe to expose in the browser)
# Copy to .env for local builds. Set the same keys in Cloudflare Pages for production.

# Stripe Payment Link for DailyDialz Solo ($99 one-time)
# Dashboard → Payment Links → create product → copy URL
# Success URL: https://dailydialz.com/buy/success
# Cancel URL:  https://dailydialz.com/buy?canceled=1
# Default in site.ts (override here if needed):
# PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/6oUcN6ad598r06Z33NgrS08
PUBLIC_STRIPE_PAYMENT_LINK=

# PayPal payment link (No Code Payments / hosted checkout)
# Default in site.ts (override here if needed):
# PUBLIC_PAYPAL_PAYMENT_LINK=https://www.paypal.com/ncp/payment/VQJ3SVLCJ6JZ2
PUBLIC_PAYPAL_PAYMENT_LINK=
