---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";

interface Props {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  showAnnouncement?: boolean;
  /** Override announcement bar copy. Used when showAnnouncement is true. */
  announcement?: string;
  /** Replace nav links with this message; keeps logo + CTA (VSL top bar). */
  navCenterText?: string;
  /** Hide the main header/nav bar only (keeps site footer). */
  hideNav?: boolean;
  /** Hide site chrome for conversion-focused sales pages (no main nav, minimal legal footer). */
  landing?: boolean;
}

const {
  title,
  description = site.description,
  canonicalPath = Astro.url.pathname.replace(/\/$/, "") || "/",
  ogType = "website",
  jsonLd,
  showAnnouncement = false,
  announcement = "One time payment · No monthly subscription · Use existing cell phone number",
  navCenterText,
  hideNav = false,
  landing = false,
} = Astro.props;

const fullTitle = title === site.name ? title : `${title} · ${site.name}`;
const canonical = new URL(canonicalPath === "/" ? "/" : canonicalPath, site.url).href;
const ogImage = new URL("/images/og.svg", site.url).href;
const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0A0A0F" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      jsonLdArray.map((data) => (
        <script type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }
  </head>
  <body class="min-h-screen bg-bg text-text antialiased">
    <a class="skip-link" href="#main">Skip to content</a>
    {
      showAnnouncement && (
        <div class="border-b border-border bg-bg-secondary px-4 py-2 text-center text-sm font-medium tracking-wide text-accent uppercase">
          {announcement}
        </div>
      )
    }
    {!landing && !hideNav && <Nav centerText={navCenterText} />}
    {
      !landing && hideNav && (
        <div class="border-b border-border bg-bg/95 px-4 py-3 sm:px-6">
          <div class="mx-auto max-w-[1280px]">
            <a
              href="/"
              class="inline-flex items-center gap-2 text-sm font-medium text-text-secondary no-underline transition-colors hover:text-text"
            >
              <span aria-hidden="true">←</span>
              Back to DailyDialz
            </a>
          </div>
        </div>
      )
    }
    <main id="main">
      <slot />
    </main>
    {
      landing ? (
        <footer class="border-t border-border bg-bg">
          <div class="mx-auto max-w-[720px] px-4 py-10 text-center sm:px-6">
            <p class="text-sm text-text-muted">© {site.year} {site.name}. All rights reserved.</p>
            <div class="mt-4 flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-sm">
              <a class="inline-flex min-h-11 items-center text-text-muted no-underline hover:text-text" href="/privacy">Privacy</a>
              <a class="inline-flex min-h-11 items-center text-text-muted no-underline hover:text-text" href="/terms">Terms</a>
              <a class="inline-flex min-h-11 items-center text-text-muted no-underline hover:text-text" href="/refund">Refund</a>
            </div>
          </div>
        </footer>
      ) : (
        <Footer />
      )
    }
  </body>
</html>
