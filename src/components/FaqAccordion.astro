---
interface Item {
  q: string;
  a: string;
}

interface Props {
  items: Item[];
  idPrefix?: string;
}

const { items, idPrefix = "faq" } = Astro.props;
---

<div class="divide-y divide-border border-y border-border">
  {
    items.map((item, i) => (
      <details class="group py-1" name={idPrefix}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 py-5 text-left text-lg font-medium text-text marker:content-none [&::-webkit-details-marker]:hidden">
          <span>{item.q}</span>
          <span class="mt-1 shrink-0 text-accent transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="pb-5 pr-8 text-[15px] leading-relaxed text-text-secondary">{item.a}</p>
      </details>
    ))
  }
</div>
