---
import { site } from "../data/site";
---

<footer class="border-t border-border bg-bg">
  <div class="mx-auto max-w-[1280px] px-4 py-10 sm:px-6 sm:py-12">
    <div class="flex justify-center px-1">
      <p class="mx-auto max-w-[34rem] text-pretty text-center text-xs leading-relaxed text-text-muted sm:max-w-[40rem]">
        DailyDialz is an independently developed product and is not affiliated with, sponsored by, or endorsed by Twilio, GoHighLevel, Calley, or any other third-party platform mentioned for comparison. All trademarks belong to their respective owners.
      </p>
    </div>
    <div class="mt-6 flex flex-col gap-3 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>© {site.year} {site.name}. All rights reserved.</p>
      <div class="flex flex-wrap gap-x-4 gap-y-1">
        <a class="inline-flex min-h-11 items-center text-text-muted no-underline hover:text-text" href="/privacy">Privacy</a>
        <a class="inline-flex min-h-11 items-center text-text-muted no-underline hover:text-text" href="/terms">Terms</a>
        <a class="inline-flex min-h-11 items-center text-text-muted no-underline hover:text-text" href="/refund">Refund</a>
      </div>
    </div>
  </div>
</footer>
