---
import { site } from "../data/site";
---

<footer class="border-t border-border bg-bg">
  <div class="mx-auto max-w-[1280px] px-4 py-12 sm:px-6 sm:py-20">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div>
        <p class="text-xl font-bold text-text">{site.name}</p>
        <p class="mt-3 max-w-xs text-[15px] leading-relaxed text-text-secondary">{site.tagline}</p>
      </div>
      <div>
        <p class="mono-label mb-4 !text-text-muted">Product</p>
        <ul class="space-y-2.5 text-[15px]">
          <li><a class="text-text-secondary no-underline hover:text-text" href="/how-it-works">How It Works</a></li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/features">Features</a></li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/use-cases">Use Cases</a></li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/pricing">Pricing</a></li>
        </ul>
      </div>
      <div>
        <p class="mono-label mb-4 !text-text-muted">Company</p>
        <ul class="space-y-2.5 text-[15px]">
          <li><a class="text-text-secondary no-underline hover:text-text" href="/about">About</a></li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/faq">FAQ</a></li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/contact">Contact</a></li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/compare/calley-alternative">Compare</a></li>
        </ul>
      </div>
      <div>
        <p class="mono-label mb-4 !text-text-muted">Get in touch</p>
        <ul class="space-y-2.5 text-[15px]">
          <li>
            <a class="text-text-secondary no-underline hover:text-text" href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li><a class="text-text-secondary no-underline hover:text-text" href="/pricing">Get DailyDialz — {site.priceLabel}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-border pt-8">
      <p class="max-w-3xl text-xs leading-relaxed text-text-muted">
        DailyDialz is an independently developed product and is not affiliated with, sponsored by, or endorsed by Twilio,
        GoHighLevel, Calley, or any other third-party platform mentioned for comparison. All trademarks belong to their
        respective owners.
      </p>
      <div class="mt-6 flex flex-col gap-3 text-sm text-text-muted sm:flex-row sm:items-center sm:justify-between">
        <p>© {site.year} {site.name}. All rights reserved.</p>
        <div class="flex flex-wrap gap-4">
          <a class="text-text-muted no-underline hover:text-text" href="/privacy">Privacy</a>
          <a class="text-text-muted no-underline hover:text-text" href="/terms">Terms</a>
          <a class="text-text-muted no-underline hover:text-text" href="/refund">Refund</a>
        </div>
      </div>
    </div>
  </div>
</footer>
