---
interface Props {
  label?: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  light?: boolean;
}

const { label, title, subtitle, align = "center", light = false } = Astro.props;
---

<div class:list={[align === "center" ? "mx-auto max-w-[1100px] text-center" : "max-w-[1100px]"]}>
  {label && <p class="mono-label">{label}</p>}
  <h2
    class:list={[
      "whitespace-pre-line text-[36px] font-bold leading-[1.2] tracking-tight sm:text-[64px]",
      label && "mt-3",
      light ? "text-bg" : "text-text",
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          "mt-4 text-lg leading-relaxed",
          light ? "text-bg/70" : "text-text-secondary",
          align === "center" && "mx-auto max-w-[1100px]",
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
