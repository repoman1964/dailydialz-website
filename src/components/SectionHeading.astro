---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  align?: "center" | "left";
  light?: boolean;
}

const { label, title, subtitle, align = "center", light = false } = Astro.props;
---

<div class:list={[align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-3xl"]}>
  <p class="mono-label">{label}</p>
  <h2
    class:list={[
      "mt-3 text-[36px] font-bold leading-[1.05] tracking-tight sm:text-[64px]",
      light ? "text-bg" : "text-text",
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          "mt-4 text-lg leading-relaxed",
          light ? "text-bg/70" : "text-text-secondary",
          align === "center" && "mx-auto max-w-2xl",
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
