---
import { trustItems } from "../data/site";
---

<div class="border-y border-border bg-bg-secondary">
  <div class="mx-auto flex max-w-[1280px] flex-wrap items-center justify-center gap-x-4 gap-y-2 px-4 py-4 sm:h-16 sm:px-6 sm:py-0">
    {
      trustItems.map((item, i) => (
        <>
          {i > 0 && (
            <span class="hidden text-accent sm:inline" aria-hidden="true">
              ·
            </span>
          )}
          <span class="font-mono text-[11px] font-medium tracking-[0.06em] text-text-secondary uppercase sm:text-xs">
            {item}
          </span>
        </>
      ))
    }
  </div>
</div>
