---
interface Props {
  label: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}

const { label, title, subtitle, compact = false } = Astro.props;
---

<section class:list={["border-b border-border bg-bg-secondary", compact ? "py-16 sm:py-20" : "py-20 sm:py-24"]}>
  <div class="mx-auto max-w-[900px] px-4 text-center sm:px-6">
    <p class="mono-label">{label}</p>
    <h1 class="mt-4 text-[40px] font-bold leading-[1.05] tracking-tight text-text sm:text-[56px]">{title}</h1>
    {
      subtitle && (
        <p class="mx-auto mt-5 max-w-[600px] text-lg leading-relaxed text-text-secondary">{subtitle}</p>
      )
    }
    <slot />
  </div>
</section>
