---
import { site } from "../data/site";

interface Props {
  label?: string;
  heading?: string;
  body?: string;
}

const {
  label = "READY TO CALL",
  heading = "Upload the list. Tap to call. Keep going.",
  body = "One-time founder pricing. No separate DailyDialz phone number for the standard mobile workflow.",
} = Astro.props;
---

<section class="border-t border-border bg-bg-secondary">
  <div class="relative overflow-hidden px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-accent-violet/20 blur-3xl" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-[720px] text-center">
      <p class="mono-label">{label}</p>
      <h2 class="mt-4 text-[36px] font-bold leading-[1.05] tracking-tight text-text sm:text-[56px]">{heading}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lg leading-relaxed text-text-secondary">{body}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
        <a href="/pricing" class="btn-primary">Get DailyDialz — {site.priceLabel}</a>
        <a href="/pricing" class="btn-ghost">See pricing →</a>
      </div>
    </div>
  </div>
</section>
