---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TrustBar from "../../components/TrustBar.astro";
import CtaBand from "../../components/CtaBand.astro";
import PageHero from "../../components/PageHero.astro";
import { features } from "../../data/site";

const included = [
  "CSV import via system file picker",
  "Phone column auto-detection",
  "Tap-to-call on your existing mobile path",
  "Dispositions and notes",
  "DNC protection for marked rows",
  "Session notification and stop controls",
  "Local persistence across kill/reboot",
  "Results export without overwriting the source",
];
---

<BaseLayout
  title="Features"
  description="DailyDialz features: use your own number, CSV list import, tap-to-call sessions, outcomes, DNC, and export—built for solo outbound."
>
  <PageHero
    label="FEATURES"
    title="Less setup. Less friction. More completed calls."
    subtitle="Every capability is scoped around the real job: get from lead list to conversation without call-center overhead."
  />
  <TrustBar />

  <section class="bg-bg px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-[1100px] space-y-8">
      {
        features.map((f, i) => (
          <article class="card grid gap-8 p-6 sm:p-8 lg:grid-cols-12 lg:items-center">
            <div class:list={["lg:col-span-5", i % 2 === 1 && "lg:order-2"]}>
              <div class="flex aspect-[4/3] items-center justify-center rounded border border-border bg-bg gradient-wash">
                <div class="px-6 text-center">
                  <p class="font-mono text-xs tracking-[0.06em] text-accent uppercase">{f.eyebrow}</p>
                  <p class="mt-3 text-2xl font-semibold text-text">{f.title}</p>
                </div>
              </div>
            </div>
            <div class:list={["lg:col-span-7", i % 2 === 1 && "lg:order-1"]}>
              <p class="mono-label">{f.eyebrow}</p>
              <h2 class="mt-3 text-[28px] font-bold text-text sm:text-[32px]">{f.title}</h2>
              <p class="mt-4 text-[16px] leading-relaxed text-text-secondary">{f.description}</p>
              <p class="mt-4 text-[15px] leading-relaxed text-text-secondary">{f.short}</p>
              <a href={`/features/${f.slug}`} class="btn-primary mt-6">
                Learn more →
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-border bg-bg-secondary px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-[800px]">
      <p class="mono-label text-center">INCLUDED AT A GLANCE</p>
      <h2 class="mt-3 text-center text-[32px] font-bold text-text sm:text-[40px]">What ships in the product.</h2>
      <ul class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          included.map((item) => (
            <li class="card flex gap-3 px-5 py-4 text-[15px] text-text-secondary">
              <span class="text-accent" aria-hidden="true">
                ✓
              </span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
