---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import {
  getSteps,
  homeFaqs,
  notForYou,
  planSteps,
  priceIncludesShort,
  priceValuePoints,
  site,
  worksWellIf,
} from "../data/site";

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: site.name,
  applicationCategory: "BusinessApplication",
  operatingSystem: "Android",
  description: site.description,
  offers: {
    "@type": "Offer",
    price: String(site.price),
    priceCurrency: "USD",
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: homeFaqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const ctaLabel = "GET DAILYDIALZ · $99 ONE TIME";
const ctaHref = site.checkoutUrl;
---

<BaseLayout
  title={`${site.name} · Your leads are waiting. Start making calls.`}
  description={site.description}
  jsonLd={[softwareLd, faqLd]}
  navCenterText="$99 Founder Pricing · 60 seconds to your first call · Use your own phone number"
>
  {/* ═══════════════════════════════════════════
      HERO — open the sales letter
  ═══════════════════════════════════════════ */}
  <section class="relative overflow-hidden border-b border-border">
    <div class="pointer-events-none absolute inset-0 gradient-wash opacity-80" aria-hidden="true"></div>
    <div
      class="relative mx-auto flex min-h-[min(88vh,920px)] max-w-[1100px] flex-col items-center justify-center px-4 py-20 text-center sm:px-6 sm:py-24"
    >
      <h1
        class="max-w-[18ch] text-[clamp(2.5rem,7vw,5.5rem)] font-bold leading-[1.02] tracking-tight text-text sm:max-w-[22ch] lg:max-w-none"
      >
        Stop getting ready.
        <span class="block text-accent">Start making calls.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-[560px] text-lg font-bold leading-relaxed text-text sm:text-xl">
        From install to your first call <span class="text-accent">in just 60 seconds.</span>
      </p>

      {/* Product / founder video — demonstration opener */}
      <div class="card mt-12 w-full max-w-[720px] overflow-hidden p-0">
        {
          site.founderVideoEmbedUrl || site.productDemoEmbedUrl ? (
            <div class="relative aspect-video w-full bg-bg-secondary">
              <iframe
                class="absolute inset-0 h-full w-full"
                src={site.productDemoEmbedUrl || site.founderVideoEmbedUrl}
                title="DailyDialz demo — see why getting started is the hardest part"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
                loading="lazy"
              />
            </div>
          ) : (
            <div class="relative flex aspect-video w-full flex-col items-center justify-center gap-4 bg-bg-secondary px-6 text-center">
              <div
                class="flex h-16 w-16 items-center justify-center rounded-full border border-accent/40 bg-accent/10 text-accent sm:h-20 sm:w-20"
                aria-hidden="true"
              >
                <svg class="ml-1 h-7 w-7 sm:h-8 sm:w-8" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7L8 5z" />
                </svg>
              </div>
              <div>
                <p class="font-mono text-xs tracking-[0.06em] text-accent uppercase">5-minute sales video</p>
                <p class="mt-2 text-xl font-semibold text-text sm:text-2xl">See why getting started is the hardest part</p>
                <p class="mx-auto mt-2 max-w-sm text-sm leading-relaxed text-text-secondary">
                  Drop your YouTube or Vimeo embed URL into{" "}
                  <span class="font-mono text-text">site.founderVideoEmbedUrl</span> to go live.
                </p>
              </div>
            </div>
          )
        }
      </div>

      <div class="mt-10 flex w-full max-w-[360px] flex-col items-stretch gap-4 sm:max-w-none sm:flex-row sm:items-center sm:justify-center">
        <a href={ctaHref} class="btn-primary w-full sm:w-auto">GET DAILYDIALZ · $99 ONE TIME</a>
      </div>
      <p class="mt-5 text-sm text-text-muted">
        14-day money-back guarantee
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CH1 — DEMONSTRATION / OUTCOME
      Visual problem or outcome (before → after)
  ═══════════════════════════════════════════ */}
  <section id="demonstration" class="scroll-mt-24 overflow-x-hidden border-b border-border bg-bg px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="mx-auto grid max-w-[1100px] items-center gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <h2 class="text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-text">
          Your first call.
          <span class="mt-1 block text-accent">60 seconds from now.</span>
        </h2>
        <p class="mt-6 text-lg leading-relaxed text-text-secondary">
          No buying a new number. No business license verification. No rebuilding your pipeline in someone else’s CRM.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-text-secondary">
          Connect your sheet. See the next lead. Tap to call.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-text-secondary">
          Use the phone and number you have in your hand right now.
        </p>
      </div>

      {/* Phone mockup — outcome visual */}
      <div class="relative mx-auto w-full max-w-[300px]">
        <div
          class="pointer-events-none absolute -inset-8 rounded-full bg-accent/15 blur-3xl"
          aria-hidden="true"
        >
        </div>
        <div
          class="relative overflow-hidden rounded-[2rem] border border-border bg-bg-secondary shadow-[0_0_0_1px_rgba(255,255,255,0.04),0_24px_80px_rgba(0,0,0,0.45)]"
        >
          <div class="flex items-center justify-center border-b border-border px-4 py-3">
            <span class="h-1.5 w-16 rounded-full bg-text-muted/40" aria-hidden="true"></span>
          </div>
          <div class="px-5 pb-8 pt-6">
            <p class="text-center font-mono text-[10px] tracking-[0.08em] text-text-muted uppercase">Call session</p>
            <p class="mt-6 text-center text-xs text-text-secondary">Next up</p>
            <p class="mt-1 text-center text-2xl font-semibold text-text">Marcus Bell</p>
            <p class="mt-1 text-center font-mono text-sm text-text-secondary">(555) 014-8821</p>
            <p class="mt-1 text-center text-xs text-text-muted">Northline Agency · Open house</p>
            <div class="mt-8 flex justify-center">
              <div
                class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-bg shadow-[0_0_32px_rgba(180,255,57,0.35)]"
                aria-hidden="true"
              >
                <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
                  <path
                    d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
                  />
                </svg>
              </div>
            </div>
            <p class="mt-4 text-center font-mono text-xs font-medium tracking-[0.06em] text-accent uppercase">
              Tap to call
            </p>
            <div class="mt-8 grid grid-cols-3 gap-2 text-center">
              <div class="rounded border border-border px-2 py-2">
                <p class="font-mono text-lg font-semibold tabular-nums text-text">12</p>
                <p class="text-[10px] text-text-muted">left</p>
              </div>
              <div class="rounded border border-border px-2 py-2">
                <p class="font-mono text-lg font-semibold tabular-nums text-text">8</p>
                <p class="text-[10px] text-text-muted">done</p>
              </div>
              <div class="rounded border border-border px-2 py-2">
                <p class="font-mono text-lg font-semibold tabular-nums text-accent">1</p>
                <p class="text-[10px] text-text-muted">hot</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CH2 — QUALIFICATION
      “Works well if…” / not for you
  ═══════════════════════════════════════════ */}
  <section id="qualification" class="scroll-mt-24 border-b border-border bg-bg-secondary px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="mx-auto max-w-[1100px]">
      <div class="mx-auto max-w-[1100px] text-center">
        <h2 class="mx-auto max-w-[20ch] text-center text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-text sm:max-w-[28ch] lg:max-w-none">
          Built exactly for you.
          <span class="mt-1 block text-accent">And the calls you need to make.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-[800px] text-lg leading-relaxed text-text-secondary">
          If you’re making the calls from leads in your spreadsheet and you want less crap between you and the next dial, DailyDialz just might be for you.
        </p>
      </div>

      <div class="mt-12 grid gap-4 lg:grid-cols-2">
        <div class="card border-accent/25 p-7 sm:p-8">
          <p class="mono-label !text-[16px]">WORKS WELL IF…</p>
          <ul class="mt-6 space-y-3">
            {
              worksWellIf.map((item) => (
                <li class="flex gap-3 text-[15px] leading-snug text-text">
                  <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                    +
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="card p-7 sm:p-8">
          <p class="mono-label !text-[16px] !text-text-muted">NOT FOR YOU IF…</p>
          <ul class="mt-6 space-y-3">
            {
              notForYou.map((item) => (
                <li class="flex gap-3 text-[15px] leading-snug text-text-secondary">
                  <span class="mt-0.5 shrink-0 text-text-muted" aria-hidden="true">
                    –
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <p class="mx-auto mt-10 max-w-[40ch] text-center text-[18px] font-bold leading-relaxed text-text sm:max-w-none">
        If you’re the one making the calls, you’re exactly who this is for.
      </p>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CH3 — THE PLAN (60–70% of the page)
      3–5 steps · show the thing is real
  ═══════════════════════════════════════════ */}
  <section id="plan" class="scroll-mt-24 border-b border-border bg-bg px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="mx-auto max-w-[1100px]">
      <div class="mx-auto max-w-[1100px] text-center">
        <h2 class="mx-auto max-w-[18ch] text-center text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-text sm:max-w-[24ch] lg:max-w-none">
          Four easy steps. <span class="text-accent">Then just do it again.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-[800px] text-lg leading-relaxed text-text-secondary">
          Preview the lead. Make the call. Log the result. Move to the next one.
        </p>
      </div>

      <div class="mt-16 space-y-16 sm:space-y-24">
        {
          planSteps.map((step, i) => {
            const reverse = i % 2 === 1;
            return (
              <div
                class:list={[
                  "grid items-center gap-8 lg:grid-cols-2 lg:gap-14",
                  reverse && "lg:[&>*:first-child]:order-2",
                ]}
              >
                <div>
                  <p class="font-mono text-sm text-accent">{step.n}</p>
                  <h3 class="mt-2 text-[28px] font-semibold leading-tight text-text sm:text-[32px]">{step.title}</h3>
                  <p class="mt-4 max-w-md text-[16px] leading-relaxed text-text-secondary">{step.body}</p>
                </div>

                {/* UI proof cards — show the thing is real */}
                <div class="card overflow-hidden p-0">
                  {step.ui === "sheet" && (
                    <div class="bg-bg-secondary p-5 sm:p-6">
                      <div class="flex items-center justify-between border-b border-border pb-3">
                        <p class="font-mono text-[11px] tracking-[0.06em] text-accent uppercase">Lead source</p>
                        <span class="rounded bg-accent/15 px-2 py-0.5 font-mono text-[10px] text-accent">Connected</span>
                      </div>
                      <div class="mt-4 space-y-2">
                        {[
                          { name: "Q3 Prospects", rows: "84 rows", active: true },
                          { name: "Open house · Sat", rows: "31 rows", active: false },
                          { name: "Warm follow-ups", rows: "12 rows", active: false },
                        ].map((sheet) => (
                          <div
                            class:list={[
                              "flex items-center justify-between rounded border px-3 py-3",
                              sheet.active ? "border-accent/40 bg-accent/5" : "border-border",
                            ]}
                          >
                            <div>
                              <p class="text-sm font-medium text-text">{sheet.name}</p>
                              <p class="mt-0.5 font-mono text-[11px] text-text-muted">{sheet.rows}</p>
                            </div>
                            {sheet.active && (
                              <span class="font-mono text-[10px] tracking-wide text-accent uppercase">Selected</span>
                            )}
                          </div>
                        ))}
                      </div>
                      <div class="mt-4 rounded border border-border bg-bg px-3 py-2.5">
                        <p class="font-mono text-[10px] text-text-muted uppercase">Phone column</p>
                        <p class="mt-1 text-sm text-text">mobile · auto-detected</p>
                      </div>
                    </div>
                  )}

                  {step.ui === "lead" && (
                    <div class="bg-bg-secondary p-5 sm:p-6">
                      <p class="font-mono text-[11px] tracking-[0.06em] text-accent uppercase">Next lead</p>
                      <p class="mt-4 text-2xl font-semibold text-text">Allison Reed</p>
                      <p class="mt-1 font-mono text-base text-text-secondary">(555) 019-4402</p>
                      <dl class="mt-6 space-y-2.5 text-sm">
                        {[
                          ["Company", "Reed & Co."],
                          ["Source", "Google Sheet · Q3 Prospects"],
                          ["Note", "Asked for pricing last week"],
                          ["Last result", "—"],
                        ].map(([k, v]) => (
                          <div class="flex justify-between gap-4 border-b border-border pb-2 last:border-0">
                            <dt class="text-text-muted">{k}</dt>
                            <dd class="text-right text-text">{v}</dd>
                          </div>
                        ))}
                      </dl>
                    </div>
                  )}

                  {step.ui === "call" && (
                    <div class="flex min-h-[280px] flex-col items-center justify-center bg-bg px-6 py-10 text-center">
                      <p class="font-mono text-[11px] tracking-[0.06em] text-text-muted uppercase">Calling</p>
                      <p class="mt-4 text-2xl font-semibold text-text">Marcus Bell</p>
                      <p class="mt-1 font-mono text-sm text-text-secondary">(555) 014-8821</p>
                      <div
                        class="mt-8 flex h-16 w-16 items-center justify-center rounded-full border border-accent/30 bg-accent/10 text-accent"
                        aria-hidden="true"
                      >
                        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="currentColor">
                          <path
                            d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
                          />
                        </svg>
                      </div>
                      <p class="mt-4 font-mono text-xs text-accent">Via your existing number</p>
                      <div class="mt-8 flex gap-3">
                        <span class="rounded border border-border px-4 py-2 text-xs text-text-muted">Mute</span>
                        <span class="rounded bg-red-500/90 px-4 py-2 text-xs font-medium text-white">End</span>
                      </div>
                    </div>
                  )}

                  {step.ui === "outcome" && (
                    <div class="bg-bg-secondary p-5 sm:p-6">
                      <p class="font-mono text-[11px] tracking-[0.06em] text-accent uppercase">Log outcome</p>
                      <p class="mt-3 text-lg font-semibold text-text">What happened?</p>
                      <div class="mt-4 grid grid-cols-2 gap-2">
                        {["No Answer", "Voicemail", "Interested", "Callback", "DNC", "Wrong number"].map((label, idx) => (
                          <span
                            class:list={[
                              "rounded border px-3 py-2.5 text-center text-sm",
                              idx === 2
                                ? "border-accent bg-accent font-semibold text-bg"
                                : "border-border text-text-secondary",
                            ]}
                          >
                            {label}
                          </span>
                        ))}
                      </div>
                      <div class="mt-4 rounded border border-border bg-bg px-3 py-3">
                        <p class="font-mono text-[10px] text-text-muted uppercase">Note (optional)</p>
                        <p class="mt-1 text-sm text-text-secondary">Wants a demo Thursday AM…</p>
                      </div>
                    </div>
                  )}

                  {step.ui === "next" && (
                    <div class="bg-bg-secondary p-5 sm:p-6">
                      <div class="flex items-center justify-between">
                        <p class="font-mono text-[11px] tracking-[0.06em] text-accent uppercase">Queue</p>
                        <span class="font-mono text-[11px] text-text-muted">9 of 84</span>
                      </div>
                      <div class="mt-4 rounded border border-accent/40 bg-accent/5 p-4">
                        <p class="text-xs text-text-muted">Up next</p>
                        <p class="mt-1 text-lg font-semibold text-text">Allison Reed is ready</p>
                        <p class="mt-1 font-mono text-sm text-text-secondary">(555) 019-4402</p>
                      </div>
                      <div class="mt-3 space-y-2 opacity-50">
                        {["Jordan Lee", "Sam Ortiz"].map((name) => (
                          <div class="rounded border border-border px-3 py-2.5 text-sm text-text-secondary">{name}</div>
                        ))}
                      </div>
                      <div class="mt-4 flex gap-2">
                        <span class="flex-1 rounded bg-accent py-3 text-center text-sm font-semibold text-bg">
                          Call next
                        </span>
                        <span class="rounded border border-border px-4 py-3 text-sm text-text-secondary">Skip</span>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            );
          })
        }
      </div>

      {/* Mid-page CTA after the plan */}
      <div class="mt-16 flex flex-col items-stretch justify-between gap-6 rounded-[var(--radius-card)] border border-border bg-bg-secondary px-6 py-6 sm:flex-row sm:items-center sm:px-8">
        <div class="text-center sm:text-left">
          <p class="font-mono text-xs tracking-[0.06em] text-accent uppercase">THAT’S HOW YOUR CALLS GET DONE.</p>
          <p class="mt-2 text-lg font-semibold text-text">Preview. Call. Log. Next.</p>
        </div>
        <a href={ctaHref} class="btn-primary w-full shrink-0 sm:w-auto">GET DAILYDIALZ · $99 ONE TIME</a>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CH4 — PRICE & VALUE
      What you get for what you pay
  ═══════════════════════════════════════════ */}
  <section id="price" class="scroll-mt-24 border-b border-border bg-bg-secondary px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="mx-auto max-w-[1100px]">
      <div class="mx-auto max-w-[1100px] text-center">
        <h2 class="mx-auto max-w-[16ch] text-center text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-text sm:max-w-none">
          Pay one time. <span class="text-accent">Keep calling.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-[52ch] text-lg leading-relaxed text-text-secondary lg:max-w-[60ch]">
          DailyDialz won’t make cold calling easy. It just gives fear less chance to turn into another reason not to start.
        </p>
      </div>

      <div class="mt-12 grid items-stretch gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        {/* Value framing — $20 gets you a $100 bill */}
        <div class="card p-7 sm:p-9">
          <p class="mono-label">WHAT YOU’RE REALLY BUYING</p>
          <h3 class="mt-3 text-[24px] font-semibold leading-snug text-text sm:text-[28px]">
            Less time talking yourself out of the call.
          </h3>
          <div class="mt-4 space-y-4 text-[15px] leading-relaxed text-text-secondary">
            <p>
              There’s always another lead to research. Another script tweak. Another list to clean up. Software to configure.
              Another reason to wait until you feel more ready.
            </p>
            <p>DailyDialz doesn’t remove the fear.</p>
            <p>It removes some of the places the fear can hide.</p>
          </div>
          <ul class="mt-8 space-y-3">
            {
              priceValuePoints.map((item) => (
                <li class="flex gap-3 text-[15px] text-text-secondary">
                  <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                    ✓
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
          <p class="mt-8 border-t border-border pt-6 text-center text-[15px] leading-relaxed">
            <span class="text-text">Confidence doesn’t come before the first call.</span>{" "}
            <span class="text-accent">It comes after.</span>
          </p>
        </div>

        {/* Price card */}
        <div class="card flex flex-col border-accent/30 p-7 sm:p-9">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="mono-label">DAILYDIALZ SOLO</p>
              <p class="mt-2 text-sm text-text-secondary">Founder pricing</p>
            </div>
            <div class="text-right">
              <p class="text-[48px] font-bold leading-none tabular-nums tracking-tight text-accent sm:text-[56px]">
                {site.priceLabel}
              </p>
              <p class="mt-1 text-sm text-text-secondary">one time</p>
            </div>
          </div>
          <ul class="mt-8 flex-1 space-y-3">
            {
              priceIncludesShort.map((item) => (
                <li class="flex gap-3 text-[15px] text-text-secondary">
                  <span class="mt-0.5 shrink-0 text-accent" aria-hidden="true">
                    ✓
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
          <div class="mt-8 border-t border-border pt-6">
            <div class="flex items-start gap-3 rounded border border-border bg-bg px-4 py-3">
              <span class="mt-0.5 text-accent" aria-hidden="true">
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                  <path
                    d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              <div>
                <p class="text-sm font-semibold text-text">14-day money-back guarantee</p>
                <p class="mt-0.5 text-sm text-text-secondary">
                  If it doesn’t make it easier to start calling and keep calling, get your money back.
                </p>
              </div>
            </div>
            <a href={ctaHref} class="btn-primary mt-5 w-full">GET DAILYDIALZ · $99 ONE TIME</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      CH5 — HOW TO GET IT
      Next step + buy button
  ═══════════════════════════════════════════ */}
  <section id="get" class="scroll-mt-24 border-b border-border bg-bg px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="mx-auto max-w-[1100px]">
      <div class="mx-auto max-w-[1100px] text-center">
        <h2 class="mx-auto max-w-[16ch] text-center text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-text sm:max-w-[22ch] lg:max-w-none">
          Buy it. Install it. <span class="text-accent">Make the first call.</span>
        </h2>
        <p class="mx-auto mt-5 max-w-[800px] text-lg leading-relaxed text-text-secondary">
          Three steps from this page to your first call.
        </p>
      </div>

      <ol class="mx-auto mt-12 grid max-w-[900px] gap-4 sm:grid-cols-3">
        {
          getSteps.map((s) => (
            <li class="card p-6 text-center sm:p-7">
              <p class="font-mono text-sm text-accent">{s.n}</p>
              <h3 class="mt-3 text-xl font-semibold text-text">{s.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-text-secondary">{s.body}</p>
            </li>
          ))
        }
      </ol>

      {/* Final purchase band */}
      <div class="mx-auto mt-12 max-w-[900px] overflow-hidden rounded-[var(--radius-card)] border border-border">
        <div class="grid lg:grid-cols-[1fr_1.1fr]">
          <div class="flex flex-col justify-center bg-accent px-8 py-10 text-bg sm:px-10">
            <p class="font-mono text-xs font-medium tracking-[0.08em] uppercase opacity-80">Time to first call</p>
            <p class="mt-3 font-mono text-[clamp(3rem,8vw,4.5rem)] font-bold leading-none tabular-nums">60 secs</p>
            <p class="mt-4 text-base font-medium leading-snug opacity-90">
              From install to your first call using the phone, number, and leads you already have.
            </p>
          </div>
          <div class="flex flex-col justify-center bg-bg-secondary px-8 py-10 sm:px-10">
            <p class="text-2xl font-bold text-text sm:text-3xl">{site.name} Solo</p>
            <p class="mt-2 text-text-secondary">Solo founder license</p>
            <div class="mt-6 flex flex-wrap items-baseline gap-3">
              <span class="text-[48px] font-bold tabular-nums tracking-tight text-text">{site.priceLabel}</span>
              <span class="text-text-secondary">one time · no subscription</span>
            </div>
            <div class="mt-8 flex w-full flex-col items-stretch sm:w-auto">
              <a href={site.checkoutUrl} id="buy" class="btn-primary w-full">
                {ctaLabel}
              </a>
              <p class="mt-4 text-center text-sm text-text-muted">14-day money back guarantee</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ═══════════════════════════════════════════
      FAQ — before you ask
  ═══════════════════════════════════════════ */}
  <section id="faq" class="scroll-mt-24 border-b border-border bg-bg-secondary px-4 py-20 sm:px-6 sm:py-[100px]">
    <div class="mx-auto max-w-[1100px]">
      <h2 class="mx-auto w-full max-w-[18ch] text-center text-[clamp(1.75rem,4.5vw,3.5rem)] font-bold leading-[1.2] tracking-tight text-text sm:max-w-[22ch] lg:max-w-none lg:whitespace-nowrap">
        A few things you might be wondering.
      </h2>
      <div class="mx-auto mt-12 max-w-[800px]">
        <FaqAccordion items={[...homeFaqs]} idPrefix="home-faq" />
      </div>
    </div>
  </section>

  {/* Closing honesty line */}
  <section class="bg-bg px-4 py-16 sm:px-6 sm:py-20">
    <div class="mx-auto max-w-[640px] text-center">
      <p class="mono-label">FULL TRANSPARENCY</p>
      <h2 class="mt-3 text-[28px] font-bold leading-tight text-text sm:text-[36px]">
        DailyDialz won’t eliminate the fear.
        <span class="block">But it will get you to the call faster.</span>
      </h2>
      <div class="mt-5 space-y-4 text-[16px] leading-relaxed text-text-secondary">
        <p>
          Cold calling doesn’t get easier the longer you think about it. And it sure as hell doesn’t get easier by hiding
          in busywork.
        </p>
        <p>It gets easier because you make the call. Then you make another one.</p>
        <p class="font-bold text-accent">Every call makes the next one a little easier.</p>
        <p>DailyDialz is built to help you take that first step.</p>
        <p>Less friction. Fewer excuses. Faster to the call.</p>
      </div>
      <a href={ctaHref} class="btn-primary mt-8 w-full max-w-[360px] sm:w-auto">{ctaLabel}</a>
    </div>
  </section>
</BaseLayout>
