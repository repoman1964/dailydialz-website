---
import BaseLayout from "../layouts/BaseLayout.astro";
import TrustBar from "../components/TrustBar.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="About"
  description="Why DailyDialz exists: a mobile cold-calling tool for solo operators who want less setup and less daily friction—not another telecom project."
>
  <section class="border-b border-border bg-bg-secondary py-16 sm:py-24">
    <div class="mx-auto grid max-w-[1100px] gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7">
        <p class="mono-label">ABOUT {site.name.toUpperCase()}</p>
        <h1 class="mt-4 text-[40px] font-bold leading-[1.05] tracking-tight text-text sm:text-[56px]">
          Built because the alternatives were overkill.
        </h1>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-text-secondary">
          DailyDialz is cold-calling software for solo founders and small outbound operators—people who need to create
          opportunities without wasting half the day configuring software.
        </p>
      </div>
      <div class="lg:col-span-5">
        <div class="card flex aspect-[4/3] items-center justify-center gradient-wash p-8">
          <div class="text-center">
            <p class="text-4xl font-bold text-text">{site.name}</p>
            <p class="mt-3 text-sm text-text-secondary">Consistency closes deals.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <TrustBar />

  <section class="bg-bg px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-[760px] space-y-6 text-[17px] leading-relaxed text-text-secondary">
      <h2 class="text-[32px] font-bold text-text sm:text-[40px]">I wanted to make calls. Not open a telecom company.</h2>
      <p>
        I did not need another phone number. I did not want another monthly telecom bill. I did not want to submit a pile of
        business information just to start calling prospects. And once I started, I did not want to manually enter dozens of
        phone numbers from a spreadsheet.
      </p>
      <p>
        I wanted a straightforward tool that worked with the phone and lead list I already had. So I built DailyDialz.
      </p>
      <p>
        It is not designed for thousand-seat call centers. It is designed for people like me—solo operators and small teams
        who need to create opportunities without the overbuilt stack.
      </p>
      <p>
        DailyDialz removes the initial setup barrier. Then it removes the daily dialing friction. The rest is up to you.
      </p>
      <p class="text-text">— Founder, {site.name}</p>
    </div>
  </section>

  <section class="border-t border-border bg-bg-secondary px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-[1100px]">
      <p class="mono-label text-center">PRINCIPLES</p>
      <h2 class="mt-3 text-center text-[32px] font-bold text-text sm:text-[40px]">How we decide what to build.</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-3">
        {
          [
            {
              t: "Consistency over gimmicks",
              b: "We’re selling fewer excuses between you and the next conversation—not magical automation that dials while you sleep.",
            },
            {
              t: "Local-first honesty",
              b: "v1 is an Android app that works with your SIM and CSV lists. We won’t market cloud features that don’t exist yet.",
            },
            {
              t: "No call-center cosplay",
              b: "If you need predictive infrastructure and multi-number fleets, we’re not the product. If you need to call your list today, we are.",
            },
          ].map((p) => (
            <div class="card p-7">
              <h3 class="text-xl font-semibold text-text">{p.t}</h3>
              <p class="mt-3 text-[15px] leading-relaxed text-text-secondary">{p.b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
